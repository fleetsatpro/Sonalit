<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/navy">

    <!-- Top status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/navy_dark"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FLEETOPS GUARDIAN"
            android:textColor="@color/cyan"
            android:textSize="10sp"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tvConvoyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONVOY"
            android:textColor="@color/navy_dark"
            android:background="@color/warning"
            android:textSize="9sp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginRight="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- DMS countdown bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/navy_card"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDmsCountdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DMS: off"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvQueueBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUEUED: 0"
            android:textColor="@color/warning"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Device info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: acquiring..."
            android:textColor="@color/body"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery: --"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- PANIC button — centered, takes remaining space -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="32dp"
        android:paddingRight="32dp">

        <Button
            android:id="@+id/btnPanic"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:text="PANIC"
            android:textColor="@color/white"
            android:background="@drawable/btn_panic"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/tvPanicMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hold to choose mode | Vol Down x3 = SOS"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Action row: Report + Check-in -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="FIELD REPORT"
                android:textColor="@color/cyan"
                android:background="@drawable/btn_outline"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/btnCheckin"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="CHECK IN"
                android:textColor="@color/success"
                android:background="@drawable/btn_outline"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/navy_dark"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvLastSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last sync: never"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <!-- Bottom button row: Settings | Convoy | Messages -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="SETTINGS"
                android:textColor="@color/muted"
                android:background="@color/transparent"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <Button
                android:id="@+id/btnConvoy"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="CONVOY"
                android:textColor="@color/warning"
                android:background="@color/transparent"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1">

                <Button
                    android:id="@+id/btnMessages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="MESSAGES"
                    android:textColor="@color/cyan"
                    android:background="@color/transparent"
                    android:textSize="10sp"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvMsgBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|right"
                    android:layout_marginTop="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@color/danger"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
