<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy">

    <!-- Top status bar -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/navy_dark"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FLEETOPS GUARDIAN"
            android:textColor="@color/cyan"
            android:textSize="10sp"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/centerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true"
        android:paddingLeft="32dp"
        android:paddingRight="32dp">

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS: acquiring..."
            android:textColor="@color/body"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery: --"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginBottom="32dp" />

        <!-- PANIC button -->
        <Button
            android:id="@+id/btnPanic"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:text="PANIC"
            android:textColor="@color/white"
            android:background="@drawable/btn_panic"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvPanicMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hold to choose mode"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnReport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_report"
            android:textColor="@color/cyan"
            android:background="@drawable/btn_outline"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_alignParentBottom="true"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvLastSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last sync: never"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textColor="#1A3550"
            android:textSize="10sp" />

    </LinearLayout>

</RelativeLayout>
