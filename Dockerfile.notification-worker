# Sonalit notification worker — standalone backend runtime
FROM node:20-alpine

WORKDIR /app/backend

# The backend package is self-contained; do not make the worker build depend on
# the monorepo package manager being installed by Railway/Railpack.
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

COPY backend ./

# Repair the approved Client Pulse XLSX parser during image build.
RUN node scripts/repair-client-pulse-xlsx-parser.js

# Client Pulse uses the approved XLSX template stored at repository root.
# Keep it outside the backend source tree and copy it explicitly into the
# runtime image because `COPY backend ./` cannot include repository-root assets.
COPY templates ./../templates

ENV NODE_ENV=production
CMD ["node", "src/workers/worker.notification.js"]
