# Sonalit notification worker — standalone backend runtime
FROM node:20-alpine

WORKDIR /app/backend

# The worker requires the backend runtime dependencies, including ExcelJS for
# reliable Client Pulse workbook generation.
COPY backend/package.json backend/package-lock.json ./
RUN npm install --omit=dev

COPY backend ./

# Client Pulse uses the approved XLSX template location for compatibility, but
# workbook generation itself is handled by ExcelJS rather than custom ZIP parsing.
COPY templates ./../templates

ENV NODE_ENV=production
CMD ["node", "src/workers/worker.notification.js"]
