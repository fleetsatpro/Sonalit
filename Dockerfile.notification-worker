# Sonalit notification worker — monorepo-root build context
FROM node:20-alpine
WORKDIR /app

# Install workspace manifests first for deterministic dependency caching.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json ./backend/package.json

RUN corepack enable && pnpm install --frozen-lockfile --prod

COPY backend ./backend

ENV NODE_ENV=production
WORKDIR /app/backend
CMD ["node", "src/workers/worker.notification.js"]
