# Sonalit notification worker — standalone backend runtime
FROM public.ecr.aws/docker/library/node:22-alpine
WORKDIR /app

# Use the repository's pnpm lockfile so the notification worker cannot drift
# from the production backend dependency graph.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json

RUN npm install --global pnpm@11.28.4 --no-audit --fund=false \
  && pnpm install --filter fleetops-backend --prod --frozen-lockfile --ignore-scripts

COPY backend ./backend

WORKDIR /app/backend
ENV NODE_ENV=production
CMD ["node", "src/workers/worker.notification.js"]
