# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:pass@localhost:5432/sonalit
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-at-least-32-characters-long

# ─── Observability ──────────────────────────────────────────────────────────
# Required for the public scrape endpoint; never expose this value to browsers.
METRICS_TOKEN=

# ─── Real-time (Centrifugo) ───────────────────────────────────────────────────
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=change-me-centrifugo-token-secret

# ─── Guardian ─────────────────────────────────────────────────────────────────
GUARDIAN_ORG_TOKEN=fleet-guardian-2024
GUARDIAN_CERT_PIN=
COMMAND_SIGNING_SECRET=change-me-command-signing-secret
IMEI_PEPPER=change-me-imei-pepper-production

# ─── Workers ──────────────────────────────────────────────────────────────────
ENABLE_INPROCESS_WORKERS=true
DISABLE_REDIS=false
NOTIFICATION_FANOUT_CONCURRENCY=3
RESEND_EMAIL_CONCURRENCY=5

# ─── Email / Resend ────────────────────────────────────────────────────────────
# Keep RESEND_API_KEY server-side only. Never expose it to apps/web or commit it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sonalit <notifications@sonalit.com>
RESEND_REPLY_TO=
RESEND_OPERATIONAL_FROM_EMAIL=Sonalit <notifications@sonalit.com>
RESEND_SECURITY_FROM_EMAIL=Sonalit Security <security@sonalit.com>
RESEND_OPERATIONAL_REPLY_TO=
RESEND_SECURITY_REPLY_TO=
RESEND_CDS_PULSE_FROM_EMAIL=
RESEND_CDS_PULSE_REPLY_TO=
RESEND_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

# Daily Client Pulse defaults to 14:00 EAT (11:00 UTC). Set false to disable.
CDS_CLIENT_PULSE_ENABLED=true
CDS_CLIENT_PULSE_UTC_HOUR=11
CDS_CLIENT_PULSE_UTC_MINUTE=0
CDS_CLIENT_PULSE_TIMEZONE=Africa/Nairobi

# Legacy SMTP variables retained for compatibility with older modules only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── SMS / WhatsApp ───────────────────────────────────────────────────────────
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# ─── God’s Eye View / External Spatial Feeds ─────────────────────────────────
# Commercial provider credentials stay server-side only. Missing credentials
# degrade the corresponding layer to AUTH_REQUIRED; Sonalit never fabricates feed data.
KPLER_AIS_TOKEN=
MAPBOX_ACCESS_TOKEN=
TOMTOM_API_KEY=
# Maximum active convoys evaluated by the automatic God’s Eye intelligence cycle.
SPATIAL_EYE_MAX_CONVOYS_PER_CYCLE=25

# ─── AI / Intelligence Provider Mesh ─────────────────────────────────────────
# Sonalit prefers independently hosted/open-weight models for the intelligence
# newsroom. Configure several different vendors; any configured provider is
# automatically added to the failover mesh.
AI_REQUEST_TIMEOUT_MS=30000

# Open-weight via OpenRouter: frontier + multimodal + zero-cost research lanes.
# Free endpoints are rate-limited and some provider terms permit logging/use of
# prompts and outputs, so Sonalit blocks them for non-public data by default.
OPENROUTER_API_KEY=
OPENROUTER_QWEN_MODEL=qwen/qwen3.5-397b-a17b
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v3.2
OPENROUTER_DEEPSEEK_V4_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_LING30_FLASH_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_GEMMA31_MODEL=google/gemma-4-31b-it:free
OPENROUTER_NEMOTRON_SUPER_FREE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_NEMOTRON_LIGHTNING_FREE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_LAGUNA_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_GEMMA_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_NEMOTRON_OMNI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_NEMOTRON_ULTRA_FREE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_QWEN38_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_NORTH_MINI_CODE_MODEL=cohere/north-mini-code:free
OPENROUTER_APODEX_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_FREE_ROUTER_MODEL=openrouter/free

# Free/open-weight activation policy.
INTEL_ALLOW_FREE_OPEN_WEIGHT=false
INTEL_DEFAULT_DATA_CLASSIFICATION=internal
INTEL_PUBLICATION_DATA_CLASSIFICATION=public
INTEL_ALLOW_FREE_CONFIDENTIAL=false

# Open-weight via NVIDIA NIM: Nemotron 3 Super 120B A12B
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NEMOTRON_LIGHTNING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Open-weight via Cerebras: independent high-speed rescue lane
CEREBRAS_API_KEY=
CEREBRAS_GPT_OSS_MODEL=gpt-oss-120b

# Optional arbitrary OpenAI-compatible open-weight endpoints (vLLM/SGLang/etc.)
OPEN_SOURCE_ALLOW_UNAUTH=false
OPEN_SOURCE_API_KEY_1=
OPEN_SOURCE_BASE_URL_1=
OPEN_SOURCE_MODEL_1=Qwen/Qwen3.5-397B-A17B
OPEN_SOURCE_API_KEY_2=
OPEN_SOURCE_BASE_URL_2=
OPEN_SOURCE_MODEL_2=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8
OPEN_SOURCE_API_KEY_3=
OPEN_SOURCE_BASE_URL_3=
OPEN_SOURCE_MODEL_3=deepseek-ai/DeepSeek-V3.2
OPEN_SOURCE_API_KEY_4=
OPEN_SOURCE_BASE_URL_4=
OPEN_SOURCE_MODEL_4=Qwen/Qwen3.5-122B-A10B
OPEN_SOURCE_API_KEY_5=
OPEN_SOURCE_BASE_URL_5=
OPEN_SOURCE_MODEL_5=Qwen/Qwen3.5-35B-A3B

# Existing non-open-weight fallbacks remain available after open-weight providers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

ENCRYPTION_KEY=

# ─── Storage ───────────────────────────────────────────────────────────────────
APK_FILE_PATH=
APK_REDIRECT_URL=
BACKEND_URL=http://localhost:5000
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Webhooks ──────────────────────────────────────────────────────────────────
FUEL_CARD_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ─── Thresholds ───────────────────────────────────────────────────────────────
SPEED_ALERT_THRESHOLD=120
GEOFENCE_RADIUS_KM=0.5
ALERT_COOLDOWN_MINUTES=15
CFO_MODULE_ENABLED=true
LOG_LEVEL=info
