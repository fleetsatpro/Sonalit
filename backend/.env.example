# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:pass@localhost:5432/sonalit
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-at-least-32-characters-long

# ─── Real-time (Centrifugo) ───────────────────────────────────────────────────
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=change-me-centrifugo-token-secret

# ─── Guardian ─────────────────────────────────────────────────────────────────
GUARDIAN_ORG_TOKEN=fleet-guardian-2024
GUARDIAN_CERT_PIN=
COMMAND_SIGNING_SECRET=change-me-command-signing-secret
IMEI_PEPPER=change-me-imei-pepper-production

# ─── Workers ──────────────────────────────────────────────────────────────────
ENABLE_INPROCESS_WORKERS=true
DISABLE_REDIS=false

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sonalit.io

# ─── SMS / WhatsApp ───────────────────────────────────────────────────────────
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Storage ──────────────────────────────────────────────────────────────────
APK_FILE_PATH=
APK_REDIRECT_URL=
BACKEND_URL=http://localhost:5000

# ─── Thresholds ───────────────────────────────────────────────────────────────
SPEED_ALERT_THRESHOLD=120
GEOFENCE_RADIUS_KM=0.5
ALERT_COOLDOWN_MINUTES=15
CFO_MODULE_ENABLED=true
LOG_LEVEL=info
