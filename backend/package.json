{
  "name": "fleetops-backend",
  "version": "1.0.0",
  "description": "FleetOps Pro — Backend API Server",
  "main": "src/app.js",
  "scripts": {
    "prestart": "node scripts/db-migrate.js",
    "start": "node src/app.js",
    "start:api": "node src/app.js",
    "start:worker:gps": "node src/workers/worker.gps.js",
    "start:worker:alert": "node src/workers/worker.alert.js",
    "start:worker:notification": "node src/workers/worker.notification.js",
    "start:worker:report": "node src/workers/worker.convoy-report.js",
    "dev": "ENABLE_INPROCESS_WORKERS=true nodemon src/app.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:status": "node scripts/db-status.js",
    "generate-openapi": "node scripts/generate-openapi.js",
    "predeploy": "node scripts/db-migrate.js",
    "seed": "node scripts/seed.js",
    "telegram:login": "node scripts/telegram-login.js",
    "workers": "node scripts/start-workers.js",
    "worker:gps": "node src/workers/worker.gps.js",
    "worker:alert": "node src/workers/worker.alert.js",
    "worker:notification": "node src/workers/worker.notification.js",
    "worker:convoy-report": "node src/workers/worker.convoy-report.js",
    "test": "jest",
    "test:integration": "jest --testPathPattern=tests/integration --runInBand --forceExit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@sentry/node": "^10.53.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^1.62.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fast-xml-parser": "^5.10.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.2",
    "telegram": "^2.26.22",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": { "jest": "^29.7.0", "nodemon": "^3.0.2", "supertest": "^6.3.4" },
  "engines": { "node": ">=20.0.0" },
  "jest": { "testEnvironment": "node", "roots": ["<rootDir>/tests"], "testMatch": ["**/*.test.js"], "testTimeout": 30000 }
}
