<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/navy_950">

    <!-- Status card -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/navy_900"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DEVICE"
                android:textColor="@color/bright"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOnlineStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Offline"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/danger"
                app:chipCornerRadius="6dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTrackingMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mode: --"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery: --"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tvSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Signal: --"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border" />

    <!-- Center actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_shield"
            android:tint="@color/danger"
            android:layout_marginBottom="20dp"
            android:contentDescription="SOS" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPanic"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="⚠  PANIC / SOS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="@color/danger"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvPanicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:paddingVertical="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="FIELD REPORT"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/cyan"
            android:textColor="@color/cyan"
            app:cornerRadius="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvReportStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:paddingVertical="6dp" />

    </LinearLayout>

</LinearLayout>
