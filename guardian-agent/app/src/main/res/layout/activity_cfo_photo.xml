<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/navy_950">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_900"
        android:minHeight="?attr/actionBarSize"
        app:titleTextColor="@color/bright"
        app:subtitleTextColor="@color/muted"
        app:navigationIcon="@drawable/ic_shield"
        app:navigationIconTint="@color/cyan" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Session selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SESSION"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginBottom="20dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOD — Start of Day"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    android:textColor="@color/chip_text_selector"
                    android:checkable="true"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EOD — End of Day"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    android:textColor="@color/chip_text_selector"
                    android:checkable="true" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Photo type selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PHOTO TYPE"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                android:layout_marginBottom="24dp" />

            <!-- Preview image -->
            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="@color/navy_800"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                android:contentDescription="Photo preview" />

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textAlignment="center"
                android:visibility="gone"
                android:paddingVertical="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Upload progress -->
            <ProgressBar
                android:id="@+id/uploadProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progressTint="@color/cyan"
                android:progressBackgroundTint="@color/navy_800"
                android:visibility="gone"
                android:indeterminate="true"
                android:layout_marginBottom="16dp" />

            <!-- Capture button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CAPTURE PHOTO"
                android:textSize="15sp"
                android:letterSpacing="0.1"
                android:backgroundTint="@color/cyan"
                android:textColor="@color/navy_950"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
