<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/navy_900"
    android:layout_marginTop="10dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- Top row: position badge + driver name + status chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Position badge -->
        <TextView
            android:id="@+id/tvPosition"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/navy_800"
            android:text="1"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDriverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Driver Name"
                android:textColor="@color/bright"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDriverPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPhotoStatus"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:text="0/0"
            android:textColor="@color/navy_950"
            android:textSize="10sp"
            app:chipBackgroundColor="@color/muted"
            app:chipCornerRadius="4dp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <!-- Photo progress bar -->
    <ProgressBar
        android:id="@+id/progressPhotos"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:progressTint="@color/cyan"
        android:progressBackgroundTint="@color/navy_800"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="10dp" />

    <!-- Photo breakdown row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvSodPhotos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SOD: 0"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvEodPhotos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EOD: 0"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tvRequiredPhotos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Required: 0"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textAlignment="textEnd" />
    </LinearLayout>

    <!-- Capture button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCapture"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="CAPTURE PHOTOS"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:backgroundTint="@color/navy_800"
        android:textColor="@color/cyan"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/cyan"
        app:cornerRadius="6dp" />

</LinearLayout>
