<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_950">

    <!-- ── Status bar ──────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/navy_900"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: device name + online chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DEVICE"
                android:textColor="@color/bright"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOnlineStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Offline"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/danger"
                app:chipCornerRadius="6dp"
                android:clickable="false" />
        </LinearLayout>

        <!-- Row 2: tracking mode / battery / signal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTrackingMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mode: --"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery: --"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Signal: --"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Divider ─────────────────────────────────────────────── -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/surface_border"
        app:layout_constraintTop_toBottomOf="@id/statusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Center: PANIC button ───────────────────────────────── -->
    <LinearLayout
        android:id="@+id/centerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SOS icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_shield"
            android:tint="@color/danger"
            android:layout_marginBottom="20dp"
            android:contentDescription="SOS" />

        <!-- PANIC button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPanic"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="⚠  PANIC / SOS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="@color/danger"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Panic status -->
        <TextView
            android:id="@+id/tvPanicStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:layout_marginBottom="20dp"
            android:paddingVertical="6dp" />

        <!-- Field report button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="FIELD REPORT"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/cyan"
            android:textColor="@color/cyan"
            app:cornerRadius="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Report status -->
        <TextView
            android:id="@+id/tvReportStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:paddingVertical="6dp" />

    </LinearLayout>

    <!-- ── Bottom info bar ────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/navy_900"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLEETOPS GUARDIAN"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
