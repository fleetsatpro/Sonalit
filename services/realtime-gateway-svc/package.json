{
  "name": "@sonalit/realtime-gateway-svc",
  "version": "4.0.0",
  "private": true,
  "description": "Sonalit v4 — Centrifugo real-time gateway; NATS→WebSocket fan-out, history, presence",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run src --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t sonalit/realtime-gateway-svc:$(git rev-parse --short HEAD) ."
  },
  "dependencies": {
    "@sonalit/contracts": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "centrifuge": "^5.2.2",
    "fastify": "^5.2.1",
    "@fastify/helmet": "^13.0.0",
    "ioredis": "^5.4.2",
    "nats": "^2.29.2",
    "pino": "^9.6.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sonalit/eslint-config": "workspace:*",
    "@sonalit/tsconfig-base": "workspace:*",
    "@testcontainers/redis": "^10.23.0",
    "@types/node": "^22.10.7",
    "testcontainers": "^10.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
