{
  "name": "@sonalit/ai-copilot-svc",
  "version": "4.0.0",
  "private": true,
  "description": "Sonalit v4 \u2014 AI copilot: RAG over pgvector+OpenSearch, SSE streaming, structured outputs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run src --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "docker:build": "docker build -t sonalit/ai-copilot-svc:$(git rev-parse --short HEAD) ."
  },
  "dependencies": {
    "@sonalit/contracts": "workspace:*",
    "@anthropic-ai/sdk": "^0.37.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opensearch-project/opensearch": "^3.0.0",
    "fastify": "^5.2.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/helmet": "^13.0.0",
    "ioredis": "^5.4.2",
    "nats": "^2.29.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sonalit/eslint-config": "workspace:*",
    "@sonalit/tsconfig-base": "workspace:*",
    "@testcontainers/postgresql": "^10.23.0",
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^10.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
