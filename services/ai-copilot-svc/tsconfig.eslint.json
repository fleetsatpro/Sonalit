{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The build config pins rootDir to src so dist/ stays flat. This config
    // never emits, so it can widen to cover tests and config files — which
    // otherwise are linted and type-checked by nothing.
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
