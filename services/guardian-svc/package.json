{
  "name": "@sonalit/guardian-svc",
  "version": "4.0.0",
  "private": true,
  "description": "Sonalit v4 — Guardian device management service (enrollment, heartbeat, commands, CFO)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t sonalit/guardian-svc:$(git rev-parse --short HEAD) ."
  },
  "dependencies": {
    "@sonalit/contracts": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "express-rate-limit": "^7.5.0",
    "fastify": "^5.2.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/helmet": "^13.0.0",
    "ioredis": "^5.4.2",
    "nats": "^2.29.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sonalit/eslint-config": "workspace:*",
    "@sonalit/tsconfig-base": "workspace:*",
    "@testcontainers/postgresql": "^10.23.0",
    "@testcontainers/redis": "^10.23.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "testcontainers": "^10.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
