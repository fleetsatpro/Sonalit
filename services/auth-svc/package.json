{
  "name": "@sonalit/auth-svc",
  "version": "4.0.0",
  "private": true,
  "description": "Sonalit v4 — Authentication & Authorization service",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --reporter=verbose src",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t sonalit/auth-svc:$(git rev-parse --short HEAD) .",
    "migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@sonalit/contracts": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@simplewebauthn/server": "^10.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "hono": "^4.6.19",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "nats": "^2.29.2",
    "node-vault": "^0.10.0",
    "otpauth": "^9.3.6",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sonalit/eslint-config": "workspace:*",
    "@sonalit/tsconfig-base": "workspace:*",
    "@testcontainers/postgresql": "^10.23.0",
    "@testcontainers/redis": "^10.23.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "testcontainers": "^10.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
