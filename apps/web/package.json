{
  "name": "@sonalit/web",
  "version": "4.0.0",
  "private": true,
  "description": "Sonalit v4 — React 18 web dashboard (TypeScript strict, TanStack Router, MapLibre GL)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && pnpm prerender",
    "prerender": "tsx scripts/prerender.tsx",
    "start": "vite preview",
    "dev": "vite",
    "test": "pnpm test:unit",
    "test:unit": "vitest run src --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
