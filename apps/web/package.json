  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.50.0",
    "@sonalit/eslint-config": "workspace:*",
    "@sonalit/tsconfig-base": "workspace:*",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.7",
