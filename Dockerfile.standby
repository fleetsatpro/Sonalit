FROM public.ecr.aws/docker/library/node:22-slim
# Standby uses the same authoritative pnpm production graph as the primary API.
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json

RUN npm install --global pnpm@11.28.4 --no-audit --fund=false \
  && pnpm install --filter fleetops-backend --prod --frozen-lockfile --ignore-scripts

COPY backend/ ./backend/
RUN mkdir -p /app/backend/logs

ENV NODE_ENV=production
ENV PORT=5000
ENV SONALIT_STANDBY=true
ENV ENABLE_INPROCESS_WORKERS=false

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||5000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "-r", "./backend/src/utils/standbyBootstrap.js", "-r", "./backend/src/utils/runtimeFenceBootstrap.js", "-r", "./backend/src/utils/runtimeDiagnosticsBootstrap.js", "-r", "./backend/src/utils/intelligenceCollectionBootstrap.js", "./backend/src/app.js"]
