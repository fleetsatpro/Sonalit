{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @sonalit/web... build && (cd apps/guardian-convoy && npm ci && npm run build) && cp apps/guardian-convoy/dist/index.html apps/web/dist/convoy.html && mkdir -p apps/web/dist/convoy-assets && cp -r apps/guardian-convoy/dist/assets apps/web/dist/convoy-assets/assets",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    { "source": "/convoy.html", "destination": "/convoy.html" },
    { "source": "/api/:path*", "destination": "https://sonalit-production.up.railway.app/api/:path*" },
    { "source": "/((?!assets|convoy-assets|icons|manifest|sw|workbox|convoy\\.html).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/convoy-assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/|convoy-assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}