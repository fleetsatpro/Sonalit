# Copy to .env on the standby host. Never commit the real file.
NODE_ENV=production
PORT=5000
SONALIT_STANDBY=true
ENABLE_INPROCESS_WORKERS=false

# Use the same authoritative production data services as the primary.
DATABASE_URL=postgresql://REPLACE_ME
REDIS_URL=redis://REPLACE_ME

# Keep auth/session secrets identical to the primary.
JWT_SECRET=REPLACE_ME
CORS_ORIGINS=https://sonalit.com

# Sonalit integrations — copy only the production values actually required by the API.
# SENTRY_DSN=
# AI_*=
# CLOUDFLARE_*=
# AWS_*=
